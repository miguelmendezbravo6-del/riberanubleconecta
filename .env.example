# Copiar a .env y reemplazar por datos reales. NO subir .env al repositorio.
APP_DOMAIN=app.ejemplo.cl
SETUP_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Ruta absoluta a la cuenta de servicio Firebase; NUNCA subir el archivo al repositorio.
FCM_SERVICE_ACCOUNT_FILE=
# Para activar notificaciones nativas con compose.fcm.yaml:
# Ruta absoluta de un archivo privado en el servidor, NO dentro del proyecto.
FCM_SERVICE_ACCOUNT_SOURCE=
# Alternativa de servidor Docker: contenido JSON de cuenta de servicio codificado en base64.
# Es un SECRETO aunque esté en base64; no publicarlo ni incluirlo en el ZIP.
FCM_SERVICE_ACCOUNT_JSON_B64=
